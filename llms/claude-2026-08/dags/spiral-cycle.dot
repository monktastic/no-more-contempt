// The core cycle, and how depth-indexing plus evocation makes it acyclic.
// Dashed red = the impossible cycle if claims are treated as single nodes.
// Solid = the actual structure once each claim is split by depth.
digraph spiral {
  rankdir=LR; compound=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  subgraph cluster_bad {
    label="Treated as three nodes: impossible"; style=dashed; color="#cc4444"; fontname="Helvetica";
    node [fillcolor="#f8dede"];
    S1 [label="SEE-SELF\nsee your own parasite"];
    O1 [label="SEE-OTHER\nsee theirs as a parasite,\nnot as them"];
    F1 [label="FREE-SELF\nnot in its grip"];
    S1 -> O1 [color="#cc4444"]; O1 -> F1 [color="#cc4444"]; F1 -> S1 [color="#cc4444"];
  }

  subgraph cluster_doors {
    label="Doors (in-degree zero from the book)"; style=dashed; color="#888888"; fontname="Helvetica";
    node [fillcolor="#fff2b3"];
    M [label="EVOCATION / memory\nyou have caught yourself (Ch1);\nyou have once seen someone fully"];
    T [label="TRANSMISSION / contact\nsomeone freer does it to you\n(the second stranger; pointing-out)"];
  }

  subgraph cluster_good {
    label="Depth-indexed: acyclic"; style=dashed; color="#888888"; fontname="Helvetica";
    node [fillcolor="#d9ead3"];
    Sa [label="SEE-SELF (1)"]; Oa [label="SEE-OTHER (1)"]; Fa [label="FREE-SELF (1)"];
    Sb [label="SEE-SELF (2)"]; Ob [label="SEE-OTHER (2)"]; Fb [label="FREE-SELF (2)"];
    Sc [label="SEE-SELF (3)\n…"];
    Sa -> Oa -> Fa -> Sb -> Ob -> Fb -> Sc;
  }

  M -> Sa [label="  base case"];
  T -> Sa [label="  base case"];
  T -> Ob [style=dotted, label="  contact can enter\n  at any depth"];
}
